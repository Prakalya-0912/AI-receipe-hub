# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ai-recipe-hub?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRE=7d

# Spoonacular API
SPOONACULAR_API_KEY=<your_spoonacular_api_key>
SPOONACULAR_BASE_URL=https://api.spoonacular.com/recipes

# Frontend URL (update after frontend deployment)
FRONTEND_URL=https://ai-recipe-hub-frontend.onrender.com